{
  "name": "dsh-usage-ledger",
  "version": "0.1.0",
  "description": "DSH token usage & cost ledger: per-session token/cost aggregation with dynamic DeepSeek official pricing (peak/off-peak aware) and daily/total budget control",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "token-usage",
    "cost-control",
    "usage-ledger",
    "budget",
    "pricing"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --expose-internals --import tsx ./node_modules/@deepseek-ai/cordis/bin.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-storage-domain": ">=0.0.1-0",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-storage-domain": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-hmr": "^1.0.16",
    "@deepseek-ai/cordis-plugin-include": "^1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/cordis-plugin-logger-console": "^1.0.1",
    "@deepseek-ai/cordis-plugin-timer": "^1.1.3",
    "@deepseek-ai/dsh-storage-domain": ">=0.0.1-0",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.1",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "packageManager": "pnpm@10.34.5"
}
