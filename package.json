{
  "name": "dsh-usage-ledger",
  "version": "0.1.0",
  "description": "DSH token usage & cost ledger: per-session token/cost aggregation with dynamic DeepSeek official pricing (peak/off-peak aware) and daily/total budget control",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "token-usage",
    "cost-control"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19 || >=24"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.0",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.0",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
