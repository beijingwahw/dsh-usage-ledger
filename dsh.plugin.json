{
  "id": "dsh-usage-ledger",
  "name": "dsh-usage-ledger",
  "version": "0.1.0",
  "description": "Per-session token usage and cost ledger with dynamic official pricing across seven vendors (peak/off-peak aware), auto price import, and daily/total/per-session budget control + web dashboard.",
  "author": "beijingwahw",
  "license": "MIT",
  "homepage": "https://github.com/beijingwahw/dsh-usage-ledger",
  "repository": {
    "type": "git",
    "url": "https://github.com/beijingwahw/dsh-usage-ledger.git"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "token-usage",
    "cost-control",
    "usage-ledger",
    "budget",
    "pricing",
    "ledger",
    "dashboard"
  ],
  "engines": {
    "node": "^22.19 || >=24",
    "dsh": ">=0.1.0-rc.1"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "entry": {
    "host": "lib/index.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "bundle": {
    "patch": "./cordis.patch.yml"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-storage-domain": ">=0.0.1-0",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-storage-domain": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  },
  "contributes": {
    "tools": ["usage_report"],
    "skills": []
  }
}
